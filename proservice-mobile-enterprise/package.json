{
  "name": "proservice-mobile-enterprise",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest",
    "test:e2e": "detox test",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:aab": "cd android && ./gradlew bundleRelease",
    "build:ios": "cd ios && xcodebuild -workspace ProService.xcworkspace -scheme ProService -configuration Release",
    "security:scan": "./scripts/validate-security.sh",
    "setup:prod": "./scripts/setup-production.sh",
    "clean": "react-native-clean-project"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.0",
    "@tanstack/react-query": "^5.0.0",
    "@reduxjs/toolkit": "^2.0.0",
    "react-redux": "^8.1.0",
    "react-native-maps": "1.7.1",
    "@stripe/stripe-react-native": "0.26.0",
    "react-native-biometrics": "^3.0.1",
    "@sentry/react-native": "^5.15.0",
    "@react-native-firebase/app": "^18.7.0",
    "@react-native-firebase/analytics": "^18.7.0",
    "@react-native-firebase/crashlytics": "^18.7.0",
    "@react-native-firebase/perf": "^18.7.0",
    "react-native-ssl-pinning": "^1.6.0",
    "@react-native-async-storage/async-storage": "^1.19.3",
    "react-native-permissions": "^3.8.0",
    "@react-native-community/netinfo": "^9.4.1",
    "axios": "^1.5.0",
    "react-native-safe-area-context": "^4.7.0",
    "react-native-screens": "^3.25.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/stack": "^6.3.0",
    "react-native-gesture-handler": "^2.13.0",
    "react-native-reanimated": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "prettier": "^3.0.0",
    "@prettier/plugin-typescript": "^0.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "detox": "^20.14.0",
    "metro-react-native-babel-preset": "^0.76.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
