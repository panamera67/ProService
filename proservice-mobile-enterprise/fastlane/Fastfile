default_platform(:android)

def notify_team(message)
  return unless ENV['SLACK_WEBHOOK_URL']

  slack(
    message: message,
    channel: '#mobile-releases',
    slack_url: ENV['SLACK_WEBHOOK_URL']
  )
end

def handle_error(exception, context)
  UI.error("❌ #{context}: #{exception.message}")

  if ENV['SLACK_WEBHOOK_URL']
    slack(
      message: "🚨 #{context} failed: #{exception.message}",
      channel: '#mobile-alerts',
      slack_url: ENV['SLACK_WEBHOOK_URL'],
      success: false
    )
  end

  raise exception
end

platform :android do
  desc '🚀 Deploy Android to Play Store'
  lane :deploy_android do
    begin
      validate_environment_android
      increment_version_code
      build_android_aab

      upload_to_play_store(
        track: 'production',
        release_status: 'draft',
        aab: 'android/app/build/outputs/bundle/release/app-release.aab',
        skip_upload_metadata: false,
        skip_upload_images: false,
        skip_upload_screenshots: false
      )

      notify_team('🤖 Android déployé en production')
    rescue => exception
      handle_error(exception, 'Android deployment failed')
    end
  end

  desc '🔐 Validate Android environment'
  lane :validate_environment_android do
    unless ENV['KEYSTORE_PATH'] && File.exist?(ENV['KEYSTORE_PATH'])
      UI.user_error!("Keystore manquant: #{ENV['KEYSTORE_PATH'] || 'non défini'}")
    end

    unless ENV['PLAYSTORE_SERVICE_ACCOUNT']
      UI.user_error!('PLAYSTORE_SERVICE_ACCOUNT manquant')
    end

    UI.success('✅ Environnement Android validé')
  end

  desc '📈 Increment version code'
  lane :increment_version_code do
    path = 'android/app/build.gradle'
    re = /versionCode\s+(\d+)/

    contents = File.read(path)
    current_code = contents[re, 1].to_i
    new_code = current_code + 1
    updated = contents.sub(re, "versionCode #{new_code}")

    File.write(path, updated)
    UI.success("✅ Version code incrémenté: #{new_code}")
  end

  desc '🏗️ Build Android AAB'
  lane :build_android_aab do
    gradle(
      task: 'bundleRelease',
      project_dir: 'android/',
      properties: {
        'android.injected.signing.store.file' => ENV['KEYSTORE_PATH'],
        'android.injected.signing.store.password' => ENV['KEYSTORE_PASSWORD'],
        'android.injected.signing.key.alias' => ENV['KEY_ALIAS'],
        'android.injected.signing.key.password' => ENV['KEY_PASSWORD']
      }
    )

    UI.success('✅ AAB buildé avec succès')
  end
end

platform :ios do
  desc '🚀 Deploy iOS to App Store'
  lane :deploy_ios do
    begin
      validate_environment_ios
      increment_ios_build_number
      build_ios_ipa

      upload_to_app_store(
        force: true,
        skip_metadata: false,
        skip_screenshots: false,
        submit_for_review: false,
        automatic_release: false
      )

      notify_team('🍎 iOS déployé en production')
    rescue => exception
      handle_error(exception, 'iOS deployment failed')
    end
  end

  desc '🔐 Validate iOS environment'
  lane :validate_environment_ios do
    UI.user_error!('MATCH_PASSWORD manquant') unless ENV['MATCH_PASSWORD']
    UI.user_error!('APPSTORE_CONNECT_API_KEY manquant') unless ENV['APPSTORE_CONNECT_API_KEY']

    UI.success('✅ Environnement iOS validé')
  end

  desc '📈 Increment build number'
  lane :increment_ios_build_number do
    next_build = latest_testflight_build_number + 1

    increment_build_number_in_plist(
      xcodeproj: 'ios/ProService.xcodeproj',
      target: 'ProService',
      build_number: next_build
    )

    UI.success("✅ Build number incrémenté: #{next_build}")
  end

  desc '🏗️ Build iOS IPA'
  lane :build_ios_ipa do
    match(
      type: 'appstore',
      readonly: true,
      api_key_path: ENV['APPSTORE_CONNECT_API_KEY']
    )

    gym(
      workspace: 'ios/ProService.xcworkspace',
      scheme: 'ProService',
      configuration: 'Release',
      export_method: 'app-store',
      include_symbols: true,
      include_bitcode: false
    )

    UI.success('✅ IPA buildé avec succès')
  end
end
